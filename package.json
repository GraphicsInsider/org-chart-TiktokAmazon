{
  "name": "bi-org-chart-template",
  "version": "1.0.0",
  "description": "Business Insider graphics team - Org chart template",
  "contributors": [
    "Sawyer Click",
    "Taylor Tyson",
    "Kazi Awal",
    "Annie Fu",
    "Randy Yeip",
    "Monsicha Srisuantang"
  ],
  "scripts": {
    "dev": "vite --host --mode development",
		"build": "vite build --mode production && cat build/index.html | pbcopy && node node_scripts/deploy.js",
		"build:preview": "vite build --mode production && node node_scripts/deploy.js",
    "deploy": "node node_scripts/deploy.js",
    "gdoc": "node node_scripts/fetch-google-doc.js",
    "data": "node node_scripts/fetch-sheet.js",
    "capi": "node node_scripts/capi.js"
  },
  "devDependencies": {
    "@rollup/plugin-dsv": "^3.0.2",
    "@sveltejs/vite-plugin-svelte": "^2.4.3",
    "archieml": "^0.5.0",
    "autoprefixer": "^10.4.14",
    "eslint": "^8.46.0",
    "eslint-plugin-svelte": "^2.32.4",
    "html-entities": "^2.4.0",
    "htmlparser2": "^9.0.0",
    "node-fetch": "^3.3.2",
    "postcss": "^8.4.27",
    "prettier": "^3.0.0",
    "prettier-plugin-svelte": "^3.0.3",
    "svelte": "^4.1.2",
    "svelte-preprocess": "^5.0.4",
    "vite": "^4.4.8"
  },
  "type": "module",
  "eslintConfig": {
    "root": true,
    "extends": [
      "eslint:recommended",
      "plugin:svelte/prettier",
      "prettier"
    ],
    "parserOptions": {
      "sourceType": "module",
      "ecmaVersion": "latest"
    },
    "env": {
      "browser": true,
      "node": true
    }
  },
  "dependencies": {
    "@sveltejs/svelte-scroller": "^2.0.7",
    "bootstrap": "^5.3.8",
    "d3": "^7.8.5",
    "feather-icons": "^4.29.2",
    "journalize": "^2.6.0",
    "layercake": "^7.6.1",
    "svelte-feather-icons": "^4.0.1"
  }
}
